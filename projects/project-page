.page-shell {
  width: min(1180px, calc(100% - 40px));
  margin: 0 auto;
  padding: 40px 0 100px;
  box-sizing: border-box;
}

.project-page {
  display: block;
}

.project-article {
  width: 100%;
}

.project-lead {
  margin: 20px 0 28px;
}

.project-lead p {
  font-size: clamp(1.05rem, 1.5vw, 1.3rem);
  line-height: 1.6;
  color: var(--text-color);
  max-width: 780px;
}

.project-meta {
  display: grid;
  grid-template-columns: repeat(3, minmax(180px, 1fr));
  gap: 18px;
  margin: 32px 0 42px;
}

.project-meta-item {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--border-radius);
  padding: 18px 20px;
}

.project-meta-item span {
  display: block;
  margin-bottom: 8px;
  color: var(--text-color-muted);
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.project-meta-item strong {
  color: var(--text-color);
  font-size: 1.05rem;
  font-weight: 500;
}

.project-section {
  margin-top: 36px;
}

.project-section h2 {
  margin: 0 0 16px;
  text-align: left;
  color: var(--text-color);
  font-size: clamp(1.35rem, 2vw, 1.9rem);
}

.project-section p,
.project-section li {
  font-size: 1.05rem;
  line-height: 1.6;
  color: var(--text-color);
}

.project-section ul {
  margin: 0;
  padding-left: 1.2rem;
}

.project-section li + li {
  margin-top: 10px;
}

@media (max-width: 760px) {
  .page-shell {
    width: min(100%, calc(100% - 24px));
    padding-top: 24px;
  }

  .project-meta {
    grid-template-columns: 1fr;
  }
}
